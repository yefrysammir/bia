# ============================================
# EJEMPLO DE CONFIGURACIÓN
# Copia este archivo como .env y llena los valores
# ============================================

# Google Sheets API (obtén estos valores de Google Cloud Console)
GOOGLE_SHEET_ID=tu_sheet_id_aqui
GOOGLE_API_KEY=tu_api_key_aqui

# WhatsApp (código de país + número, sin espacios)
WHATSAPP_NUMBER=519XXXXXXXX

# Configuración de la App
APP_NAME=Mi Tienda Shop
APP_DESCRIPTION=Tienda online con carrito y WhatsApp
APP_URL=https://tu-dominio.vercel.app

# Moneda (PEN, USD, EUR, etc.)
CURRENCY=PEN
CURRENCY_SYMBOL=S/
